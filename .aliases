# Listing
alias ls='ls -G'
alias la='ls -lahF'
alias grep='grep --color=auto'
export LSCOLORS='Dxexcxdxcxegedabagacad'

# Homebrew
alias update_brew='brew update && brew upgrade && brew cleanup'

# Python
alias activate='source .venv/bin/activate'
alias serve='uvicorn app.main:app --reload --host 127.0.0.1 --port 8000'

# Flutter
alias flutterwatch='dart run build_runner watch --delete-conflicting-outputs'

# Keep the Mac awake until Ctrl-C (-d display, -i idle, -m disk, -s system).
# Extra args pass through, e.g. `caf -t 3600` for a one-hour limit,
# or `caf make build` to stay awake only for that command's duration.
alias caf='caffeinate -dims'
